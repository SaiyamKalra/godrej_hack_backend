# ==============================================================================
# WareWatch Backend - Environment Configuration Template
# ==============================================================================

# Server Port
PORT=8080

# PostgreSQL Connection String (Prisma ORM)
DATABASE_URL=postgresql://app:password@localhost:5432/myapp
# If running inside Docker Compose:
# DATABASE_URL=postgresql://app:password@postgres:5432/myapp

# Ollama LLM Configuration (for WareWatch AI Operations Assistant)
OLLAMA_BASE_URL=http://localhost:11434
# If running inside Docker Compose:
# OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_VOLUME_PATH=/home/namangoyal/.ollama:/root/.ollama

# Computer Vision Inference Service
INFERENCE_SERVICE_URL=http://localhost:8000
# If running inside Docker Compose:
# INFERENCE_SERVICE_URL=http://inference:8000

# Cache & Search (Optional - graceful fallback if disabled)
REDIS_URL=redis://localhost:6379
ELASTIC_SEARCH_URL=http://localhost:9200
# If running inside Docker Compose:
# REDIS_URL=redis://redis:6379
# ELASTIC_SEARCH_URL=http://elasticsearch:9200

# Incident Video Clips & Snapshots Directory
CLIP_OUTPUT_DIR=/app/clips

# Firebase Admin Authentication
FIREBASE_PROJECT_ID=warewatch2026
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@warewatch2026.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
